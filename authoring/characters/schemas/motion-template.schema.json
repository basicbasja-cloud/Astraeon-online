  "$defs": {
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "rotation",
        "scale"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "rotation": {
          "type": "number",
          "description": "Clockwise radians in canvas coordinates"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "frame": {
      "type": "object",
      "required": [
        "id",
        "durationMs",
        "role",
        "referencePhase",
        "root",
        "anchors",
        "events"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_./-]*$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "referenceKey",
            "astraeonInbetween"
          ]
        },
        "referencePhase": {
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "$ref": "#/$defs/transform"
        },
        "anchors": {
          "type": "object",
          "required": [
            "root",
            "head",
            "mainHand",
            "offHand",
            "back",
            "waist",
            "footL",
            "footR"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/transform"
          }
        },
        "drawProfile": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_./-]*$"
        },
        "drawOrder": {
          "type": "array",
          "items": {
            "enum": [
              "Shadow",
              "GarmentBack",
              "Body",
              "HeadBase",
              "HairBack",
              "HairFront",
              "HeadgearLower",
              "HeadgearMiddle",
              "HeadgearTop",
              "MainHand",
              "WeaponSlash",
              "OffHand",
              "GarmentFront",
              "BackAccessory",
              "CosmeticFX"
            ]
          },
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "authority"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_./-]*$"
              },
              "authority": {
                "const": "presentation"
              }
            }
          }
        },
        "source": {
          "type": "object"
        },
        "poseIntent": {
          "type": "object",
          "required": [
            "bodyOrientation",
            "limbPhase",
            "footContact",
            "attackPhase",
            "silhouette"
          ],
          "properties": {
            "bodyOrientation": {
              "type": "string",
              "minLength": 1
            },
            "limbPhase": {
              "type": "string",
              "minLength": 1
            },
            "footContact": {
              "type": "string",
              "minLength": 1
            },
            "attackPhase": {
              "type": "string",
              "minLength": 1
            },
            "silhouette": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "between": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_./-]*$"
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "bodyPose": {
          "type": "object"
        },
        "evidenceClass": {
          "enum": [
            "ACT_EXTRACTED",
            "RENDERED_REFERENCE",
            "VIDEO_DERIVED",
            "VISUAL_DERIVED",
            "ASTRAEON_INBETWEEN"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "referenceKey"
              }
            }
          },
          "then": {
            "required": [
              "source",
              "poseIntent"
            ],
            "properties": {
              "referencePhase": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_./-]*$"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "between"
                  ]
                },
                {
                  "required": [
                    "fraction"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "between",
              "fraction"
            ],
            "properties": {
              "referencePhase": {
                "type": "null"
              },
              "events": {
                "maxItems": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "source"
                  ]
                },
                {
                  "required": [
                    "poseIntent"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
