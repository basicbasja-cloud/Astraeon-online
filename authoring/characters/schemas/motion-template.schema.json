{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraeon.invalid/schemas/motion-template-v1",
  "title": "ASTRAEON executable MotionTemplate v1",
  "description": "Cross-frame provenance, stable root, key timestamps, neighboring-key links and profile resolution are additionally checked by character-motion-template.js. REFERENCE_DATA_REQUIRED drafts intentionally fail.",
  "type": "object",
  "required": [
    "schemaVersion",
    "motionTemplateId",
    "status",
    "provenance",
    "directions",
    "registration",
    "transformConvention",
    "drawProfiles",
    "defaultDrawProfile",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "motionTemplateId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_./-]*$"
    },
    "status": {
      "enum": [
        "DEV_ONLY",
        "REQUIRES_OWNER_VISUAL_REVIEW",
        "APPROVED"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "SYNTHETIC_ENGINE_FIXTURE",
            "RO1_DERIVED"
          ]
        },
        "referenceManifestSHA256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "directions": {
      "const": [
        "S",
        "SW",
        "W",
        "NW",
        "N",
        "NE",
        "E",
        "SE"
      ]
    },
    "registration": {
      "type": "object",
      "required": [
        "canvas",
        "root",
        "referenceHeight",
        "mirroring"
      ],
      "properties": {
        "canvas": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "root": {
          "$ref": "#/$defs/transform"
        },
        "referenceHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mirroring": {
          "const": "none"
        }
      }
    },
    "transformConvention": {
      "const": "canvas pixels; clockwise radians; uniform positive scale"
    },
    "drawProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "enum": [
            "Shadow",
            "GarmentBack",
            "Body",
            "HeadBase",
            "HairBack",
            "HairFront",
            "HeadgearLower",
            "HeadgearMiddle",
            "HeadgearTop",
            "MainHand",
            "WeaponSlash",
            "OffHand",
            "GarmentFront",
            "BackAccessory",
            "CosmeticFX"
          ]
        },
        "minItems": 15,
        "maxItems": 15,
        "uniqueItems": true
      }
    },
    "defaultDrawProfile": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_./-]*$"
    },
    "actions": {
