              "N",
              "NE",
              "E",
              "SE"
            ],
            "additionalProperties": false,
            "properties": {
              "S": {
                "type": "object",
                "required": [
                  "totalDurationMs",
                  "referenceKeys",
                  "frames"
                ],
                "properties": {
                  "totalDurationMs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "referenceKeys": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/frame"
                        },
                        {
                          "properties": {
                            "role": {
                              "const": "referenceKey"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "frames": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/frame"
                    }
                  },
                  "drawProfile": {
                    "type": "string",
