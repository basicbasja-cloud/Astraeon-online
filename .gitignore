__pycache__/
*.pyc
*.blend1
.character-tools/
.factory-replay/

# Provider-delivered motion and receipts stay local: standard licenses can
# prohibit raw source redistribution, and checkout receipts may contain PII.
authoring/characters/factory-v3/motions/inbox/*
authoring/characters/factory-v3/motions/raw/*
!authoring/characters/factory-v3/motions/inbox/.gitkeep
!authoring/characters/factory-v3/motions/raw/.gitkeep
authoring/characters/factory-v3/motions/retargeted/*

# Animated guide passes contain hundreds of full-canvas PNG/EXR intermediates.
# Keep review contact sheets and compact reports in the docs evidence bundle.
authoring/characters/factory-v3/renders/animation-*/
