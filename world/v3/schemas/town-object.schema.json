{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraeon.local/world/v3/town-object.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "family": {
      "enum": [
        "civic",
        "vegetation",
        "fortification",
        "residential",
        "market",
        "inn",
        "workshop",
        "shrine"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "solid",
              "overhead",
              "decorative"
            ]
          },
          "shadow": {
            "type": "boolean"
          },
          "material": {
            "type": "string"
          },
          "vertices": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          },
          "faces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "uvs": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "vertexOpacity": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "visible": {
            "type": "boolean"
          },
          "bakedLighting": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "required": [
          "id",
          "role",
          "shadow",
          "material",
          "vertices",
          "faces"
        ],
        "additionalProperties": false
      }
    },
    "portals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "anchor": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "approach": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "range": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "transition": {
            "type": "object",
            "properties": {
              "to": {
                "enum": [
                  1,
                  2
                ]
              },
              "label": {
                "type": "string"
              },
              "glyph": {
                "type": "string"
              },
              "arrival": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "to",
              "label",
              "glyph",
              "arrival"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "anchor",
          "approach",
          "range"
        ],
        "additionalProperties": false
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "color": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          }
        },
        "required": [
          "id",
          "position",
          "radius",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "footprintReview": {
          "type": "string"
        },
        "sprite": {
          "type": "object",
          "properties": {
            "art": {
              "type": "string"
            },
            "pack": {
              "type": "string"
            },
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "building": {
              "type": "boolean"
            },
            "tree": {
              "type": "boolean"
            }
          },
          "required": [
            "art",
            "w",
            "h"
          ],
          "additionalProperties": false
        },
        "structure": {
          "type": "object",
          "properties": {
            "district": {
              "type": "string"
            },
            "groundPolygon": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "renderAnchor": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "entrance": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "light": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "region": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    }
                  },
                  "depth": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "polygon": {
                    "anyOf": [
                      {
                        "type": "array",
                        "minItems": 3,
                        "items": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "number"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "exclude": {
                    "anyOf": [
                      {
                        "type": "array",
                        "minItems": 3,
                        "items": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "number"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "visibility": {
                    "enum": [
                      "selective-overhead"
                    ]
                  }
                },
                "required": [
                  "name",
                  "region",
                  "depth"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "district",
            "renderAnchor",
            "entrance",
            "light",
            "layers"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "position",
        "sprite",
        "footprintReview"
      ],
      "additionalProperties": false
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "guild",
              "craft",
              "market",
              "travel",
              "housing",
              "journal",
              "inn",
              "shrine"
            ]
          },
          "symbol": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "archetype": {
            "type": "string",
            "enum": [
              "warrior",
              "mage",
              "ranger"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "symbol",
          "position"
        ],
        "additionalProperties": false
      }
    },
    "walkers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "pace": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "tint": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "craft",
              "guild",
              "housing",
              "inn",
              "market",
              "shrine",
              "travel"
            ]
          },
          "route": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "archetype": {
            "type": "string",
            "enum": [
              "warrior",
              "mage",
              "ranger"
            ]
          }
        },
        "required": [
          "id",
          "pace",
          "tint",
          "route"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "family",
    "parts",
    "portals",
    "lights"
  ],
  "additionalProperties": false
}
