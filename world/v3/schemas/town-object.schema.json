{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astraeon.local/world/v3/town-object.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "family": {
      "enum": [
        "civic",
        "vegetation",
        "fortification",
        "residential",
        "market",
        "inn",
        "workshop",
        "shrine"
      ]
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "solid",
              "overhead",
              "decorative"
            ]
          },
          "shadow": {
            "type": "boolean"
          },
          "material": {
            "type": "string"
          },
          "vertices": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          },
          "faces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "required": [
          "id",
          "role",
          "shadow",
          "material",
          "vertices",
          "faces"
        ],
        "additionalProperties": false
      }
    },
    "portals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "anchor": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "approach": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "range": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "anchor",
          "approach",
          "range"
        ],
        "additionalProperties": false
      }
    },
    "lights": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "color": {
            "type": "string",
            "pattern": "^#[a-fA-F0-9]{6}$"
          }
        },
        "required": [
          "id",
          "position",
          "radius",
          "color"
        ],
        "additionalProperties": false
      }
    },
    "presentation": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "footprintReview": {
          "type": "string"
        },
        "sprite": {
          "type": "object",
          "properties": {
            "art": {
              "type": "string"
            },
            "pack": {
              "type": "string"
            },
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "building": {
              "type": "boolean"
            },
            "tree": {
              "type": "boolean"
            }
          },
          "required": [
            "art",
            "w",
            "h"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "position",
        "sprite",
        "footprintReview"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "family",
    "parts",
    "portals",
    "lights"
  ],
  "additionalProperties": false
}
